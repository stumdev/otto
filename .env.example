# =====================================================================
# Otto — configuração do servidor. Copie para ".env" e preencha.
# NUNCA versione o .env (já está no .gitignore).
# =====================================================================

# ---------- Básico ----------
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
# Pasta dos dados: directory.db (contas) + users/<id>.db (um banco por usuário). No Docker, ./data vira /data.
DATA_DIR=/data
# "true" se o servidor ficar atrás de um proxy (Caddy, Cloudflare Tunnel) — necessário
# para o rate limit enxergar o IP real.
TRUST_PROXY=true

# Cadastro: vazio = qualquer pessoa cria conta. Defina um código para limitar a convidados.
SIGNUP_CODE=
# Cadastros por IP por hora
SIGNUP_RATE_PER_HOUR=10

# ---------- Modo ----------
# true  = dados fictícios por usuário (nenhuma chave necessária; "Conectar" no app cria uma conta de exemplo)
# false = dados reais via Pluggy (preencha a seção abaixo)
MOCK_MODE=true

# ---------- Pluggy / Open Finance (só com MOCK_MODE=false) ----------
# Dashboard: https://dashboard.pluggy.ai  ·  Uso pessoal grátis: https://meu.pluggy.ai
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
# (Os itens/conexões são criados por cada usuário dentro do app, pelo widget Pluggy Connect.)
# URL pública HTTPS deste servidor (para registrar o webhook). Ex.: https://otto.seudominio.com
PUBLIC_BASE_URL=
# Segredo enviado pela Pluggy no cabeçalho Authorization do webhook (npm run gen-token)
PLUGGY_WEBHOOK_HEADER_SECRET=
# Segredo de assinatura (whsec_...) gerado no Dashboard > Aplicação > Webhooks (opcional, recomendado)
PLUGGY_WEBHOOK_SIGNING_SECRET=
# Durante a rotação do segredo de assinatura: coloque o antigo aqui e ROTATING=true
PLUGGY_WEBHOOK_SIGNING_SECRET_PREVIOUS=
PLUGGY_WEBHOOK_ROTATING=false
# Polling de segurança (minutos). Só leitura: não dispara atualização no banco.
SYNC_INTERVAL_MINUTES=5
# Não notificar transações mais antigas que isso (horas)
NOTIFY_MAX_AGE_HOURS=72
# Alertas instantâneos: movimentação lida da notificação do banco que a Pluggy não confirmar
# neste prazo (horas) deixa de contar no saldo. Meu Pluggy atualiza a cada 24 h; 96 dá folga.
PROVISIONAL_TTL_HOURS=96

# ---------- Push (Firebase Cloud Messaging) ----------
# Caminho do JSON da conta de serviço do Firebase. Vazio = sem FCM (o app usa notificação local por polling).
# No Docker, coloque o arquivo em ./secrets/ e use /run/secrets/otto/firebase-service-account.json
# Fora do Docker, use um caminho local, ex.: ../secrets/firebase-service-account.json
FIREBASE_SERVICE_ACCOUNT_FILE=

# ---------- IA ----------
# Ordem de tentativa. Sem nenhuma chave, o chat usa o motor de regras offline.
AI_PROVIDER_ORDER=groq,gemini
# Groq (principal): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
# Gemini (fallback): https://aistudio.google.com/apikey
# Atenção: no plano grátis do Gemini o Google pode usar o conteúdo para melhorar produtos.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=30000
AI_MAX_RETRIES=2

# ---------- Padrões dos ajustes (o app pode mudar depois) ----------
# Alerta de saída grande, em centavos (100000 = R$ 1.000,00). 0 desliga.
DEFAULT_BIG_OUTFLOW_CENTS=100000
DEFAULT_DAILY_SUMMARY_TIME=22:00
